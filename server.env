# Ajustes del servidor. Se leen al iniciar con:  python server.py
# (en Windows: .venv\Scripts\python server.py)
#
# on = prendido, off = apagado. Después de cambiar algo, reiniciá el servidor.
# Si ponés una variable en la consola (por ejemplo SE_PVP=off python server.py), esa gana sobre este archivo.
# Una línea que empieza con # no se usa.

# --- Funciones nuevas ---
# Duelos en tiempo real entre jugadores
SE_DUELS=on
# Clanes
SE_CLANS=on
# Habilidades de las unidades
SE_ABILITIES=on
# Botón PvP en el juego y elección de tropas para saqueos y duelos
SE_PVP=on
# Pase de temporada gratuito: un pase por estación de Argentina, con desafíos y premios (botón "Pase" en el juego)
SE_SEASON_PASS=on

# --- Arreglos (prendidos de fábrica) ---
# Dardos diarios, con jugadas y premios guardados
SE_DAILY_DARTS=on
# El nombre del jugador (solo letras y números) nombra el imperio y se ve en la barra de amigos
SE_EMPIRE_NAME=on
# Hechizos y maná, mercado, desbloqueo de edificios, población y almacén se guardan
SE_VILLAGE_COMMANDS=on
# Letras blancas con borde negro, nombres de castillos y torres, unidades agotadas fuera de la ventana de tropas
SE_READABLE_UI=on
# El juego recuerda si apagaste la música y el sonido
SE_SOUND_FIX=on
# Lo que hacés se envía al servidor cada 3 segundos (antes ~30): recargar ya no deshace lo último
SE_QUICK_SAVE=on
# El clima de la aldea sigue las estaciones de Argentina (verano desierto, otoño montañas, invierno nieve, primavera praderas)
SE_SEASONS=on
# Día y noche según la hora de Argentina, con lluvia o nieve según la estación
SE_DAY_NIGHT=on
# HUD mejorado (punto 26): reloj con la hora y el clima de la aldea sobre el juego (necesita SE_DAY_NIGHT)
SE_HUD=on
# Íconos del juego en HD: los dibujos chicos del juego al doble de píxeles, agrandados con IA (config/hd_icons)
SE_HD_ICONS=on
# Dibujos del mapa en HD (assets_hd, hechos con tools/make_hd_sprites.py): recursos = solo los recursos del mapa
# (molinos, cultivos, granjas, minas, árboles, rocas); on = todo lo que esté hecho; off = ninguno
SE_HD_SPRITES=recursos
# Explorador del mundo del juego: islas con jugadores reales, ataques, espionajes y conquista de territorios
SE_WORLD_EXPLORER=on
# Las cuentas nuevas entran sin esperar aprobación del administrador
SE_AUTO_APPROVE=on
# Actualizador: python server.py vigila los commits y server.env; con un cambio corre las pruebas, prueba que el
# servidor nuevo arranque y recién ahí lo reemplaza (registro en instance/actualizaciones.log). off: el servidor de antes
SE_AUTO_UPDATE=on
# Aviso a los jugadores cuando el servidor se actualizó: "Hay una actualización disponible" con el botón Reiniciar
# (a los 10 segundos la página se reinicia sola)
SE_UPDATE_NOTICE=on

# --- Avanzado (sin poner, el valor de fábrica) ---
# Forma de dibujo de Ruffle: webgpu, wgpu-webgl, webgl o canvas. Si el juego se cierra solo, probá webgl.
# SE_RUFFLE_RENDERER=webgl
# Calidad de imagen: low, medium, high, best, 8x8, 16x16
# SE_RUFFLE_QUALITY=high
# Duelos: segundos mínimos de una batalla (más cortas se rechazan)
# SE_DUEL_MIN_SECONDS=20
# Duelos: segundos para informar el resultado desde que empieza
# SE_DUEL_DEADLINE_SECONDS=600
# Duelos: si el ganador tenía menos que esta parte de la fuerza del perdedor, va a revisión
# SE_DUEL_POWER_RATIO=0.333
# Duelos: cuánto más cuenta una unidad que lanza sus habilidades sola (0.25 = 25 %)
# SE_DUEL_ABILITY_BONUS=0.25
# Duelos y torneos: la arena de torneos (por defecto config/duels/arena.json)
# SE_DUEL_ARENA_FILE=config/duels/arena.json
# Duelos: carpeta de las arenas PvP del World Editor (cada duelo usa una al azar; sin ninguna, la de torneos)
# SE_DUEL_ARENAS_DIR=config/duels/arenas
# Habilidades: muestra en la consola lo que informa el juego (solo para probar)
# SE_ABILITIES_DEBUG=off
# Íconos HD: números de imágenes que quedan sin HD, separados por coma (si alguna se viera mal)
# SE_HD_ICONS_SKIP=1259,783
# Puerto y dirección del servidor
# PORT=5050
# HOST=127.0.0.1
